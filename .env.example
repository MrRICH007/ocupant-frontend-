# Copy this file to .env and fill in real values
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DB_FILE=ocupant.db

# Flutterwave (get keys from https://dashboard.flutterwave.com -> Settings -> API Keys)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Secret you set in Dashboard -> Settings -> Webhooks (verif-hash)
FLUTTERWAVE_WEBHOOK_HASH=choose-a-long-random-string

# Pricing
PREMIUM_PRICE=29
PAYMENT_CURRENCY=USD

# URLs used for payment redirects
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
